# Optional. Required only to refresh data/live via ingest.
# The committed season caches run the site without a key.
# Key from https://collegefootballdata.com/key
# Never commit a real key.
CFBD_API_KEY=

# Season to ingest and display. Default is the 2026 season.
SEASON_YEAR=2026

# Local site port. Default is 8742.
PORT=8742
